#!/usr/bin/env node
'use strict'
// Opt-in trigger measurement. Contract: docs/specs/lifecycle.md#eval. Never reads session archives.
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')
const crypto = require('node:crypto')
const { spawn, spawnSync } = require('node:child_process')
const ROOT = path.resolve(__dirname, '..')
const MODEL = 'gpt-6.1-sol'
const EFFORT = 'high'
const TIMEOUT = 300000
const MAX_OUTPUT = 8 * 1024 * 1024
const normalize = s => s.replaceAll('\\', '/').replace(/\/+$/, '')
const toml = s => JSON.stringify(normalize(s))
const usageKeys = ['input_tokens', 'cached_input_tokens', 'output_tokens']
const safeNumber = n => Number.isSafeInteger(n) && n >= 0
const READ = /^(?:Get-Content|cat|head|tail|sed|rg|readFileSync|readFile|read_text)\b/i

function parseTrace(text, skillRoot) {
  const detected = new Set()
  const usage = Object.fromEntries([...usageKeys, 'total_tokens'].map(k => [k, 0]))
  let turns = 0, started = false, broken = false
  const commands = new Map()
  const fold = s => process.platform === 'win32' || /^[a-z]:\//i.test(normalize(skillRoot)) ? s.toLowerCase() : s
  const root = fold(normalize(skillRoot)) + '/'
  for (const line of text.split(/\r?\n/).filter(l => l.trim())) {
    let event
    try { event = JSON.parse(line) } catch { broken = true; continue }
    if (!event || typeof event !== 'object') { broken = true; continue }
    if (event.type === 'thread.started') started = true
    if (event.type === 'error' || event.type === 'turn.failed') broken = true
    if (event.type === 'turn.completed') {
      if (!event.usage || usageKeys.some(k => !safeNumber(event.usage[k])) || event.usage.cached_input_tokens > event.usage.input_tokens) {
        broken = true
        continue
      }
      turns++
      for (const k of usageKeys) usage[k] += event.usage[k]
      usage.total_tokens += event.usage.input_tokens + event.usage.output_tokens
    }
    if (!/^item\./.test(event.type || '') || event.item?.type !== 'command_execution' || typeof event.item.command !== 'string') continue
    if (commands.size < 100) commands.set(event.item.id || event.item.command, event.item.command.slice(0, 2000))
    // Literal read operations only. Messages, command output, listings and echoed paths are not trigger evidence.
    const command = normalize(event.item.command.replaceAll('\\"', '"'))
    const unwrapped = command.replace(/^(?:"[^"]+"|[^\s]+)\s+(?:-[\w-]+\s+)*-(?:Command|lc|c)\s+["']?/i, '')
    if (!READ.test(unwrapped) || /^rg\b.*\s--files(?![\w-])/i.test(unwrapped)) continue
    // Tokenize literal operands of the first read; quoted echo text and later commands are data.
    const operands = unwrapped.replace(READ, '')
    // rg's first non-option operand is the search pattern, not a file.
    let pattern = /^rg\b/i.test(unwrapped)
    for (const m of operands.matchAll(/'([^']*)'|"([^"]*)"|([;|&])|([^\s'";|&]+)/g)) {
      if (m[3]) break
      const file = m[1] ?? m[2] ?? m[4]
      if (pattern && !file.startsWith('-')) { pattern = false; continue }
      const key = fold(file)
      if (!key.startsWith(root)) continue
      const relative = file.slice(root.length)
      if (/^[A-Za-z0-9_.-]+\/SKILL\.md$/i.test(relative)) detected.add(fold(relative.split('/')[0]))
    }
  }
  return { detectedSkills: [...detected].sort(), usage: turns ? usage : null, commandExecutions: commands.size, commands: [...commands.values()], valid: started && turns > 0 && !broken }
}

function loadCases(dir) {
  return fs.readdirSync(dir).sort().map(id => {
    if (!/^[a-z][a-z-]*--[a-z][a-z-]*$/.test(id)) throw new Error('Invalid case name')
    const file = path.join(dir, id, 'prompt.md')
    if (!fs.lstatSync(file).isFile()) throw new Error('Case is not a regular file')
    const text = fs.readFileSync(file, 'utf8')
    const fm = /^---\r?\n([\s\S]*?)\r?\n---\r?\n/.exec(text)
    if (!fm || !fm[1].includes('tags: [trigger,')) throw new Error('Missing trigger metadata')
    const graders = fs.readdirSync(path.join(dir, id, 'graders'))
    if (graders.length !== 1) throw new Error('Expected one trigger grader')
    const grader = fs.readFileSync(path.join(dir, id, 'graders', graders[0]), 'utf8')
    const target = id.split('--')[0]
    const policy = target === 'none' ? 'none' : /^max: 0\r?$/m.test(grader) ? 'forbidden' : 'required'
    if (!grader.includes('devflow:') || (target !== 'none' && !grader.includes('devflow:' + target))) throw new Error('Case and grader disagree')
    return { id, expectedSkill: target === 'none' ? null : target, policy, prompt: text.slice(fm[0].length), promptHash: crypto.createHash('sha256').update(text).digest('hex') }
  })
}

function score(c, trace) {
  if (!trace.valid) return 'invalid'
  const hit = trace.detectedSkills.includes(c.expectedSkill)
  return (c.policy === 'none' ? trace.detectedSkills.length === 0 : c.policy === 'forbidden' ? !hit : hit) ? 'pass' : 'fail'
}

function summarize(cases) {
  const valid = cases.filter(c => c.result !== 'invalid')
  const positives = valid.filter(c => c.policy === 'required')
  const negatives = valid.filter(c => c.policy !== 'required')
  const triggerRate = positives.length ? positives.filter(c => c.result === 'pass').length / positives.length : null
  const falsePositiveRate = negatives.length ? negatives.filter(c => c.result === 'fail').length / negatives.length : null
  return { attempted: cases.length, passed: valid.filter(c => c.result === 'pass').length, failed: valid.filter(c => c.result === 'fail').length,
    invalid: cases.length - valid.length, triggerRate, falsePositiveRate,
    totalTokens: cases.reduce((n, c) => n + (c.tokens?.total_tokens || 0), 0), usageKnown: cases.every(c => c.tokens !== null),
    thresholdPassed: triggerRate !== null && falsePositiveRate !== null && triggerRate >= 0.8 && falsePositiveRate <= 0.1, perCase: perCase(cases) }
}

// Variation across repetitions of one case: its result counts and every distinct set of skills it read.
function perCase(cases) {
  const out = {}
  for (const c of cases) {
    const p = out[c.id] ??= { attempts: 0, pass: 0, fail: 0, invalid: 0, judgmentStable: true, skillSets: [], tokens: 0 }
    p.attempts++
    p[c.result]++
    p.tokens += c.tokens?.total_tokens || 0
    const set = (c.detectedSkills || []).join('+') || '-'
    if (!p.skillSets.includes(set)) p.skillSets.push(set)
  }
  for (const p of Object.values(out)) {
    p.skillSets.sort()
    p.judgmentStable = [p.pass, p.fail, p.invalid].filter(Boolean).length <= 1
  }
  return out
}

function parseArgs(args) {
  const opts = { smoke: false, full: false, repetitions: 1, budgetTokens: null, priorResults: null, continueFrom: null }
  const value = i => {
    if (typeof args[i] !== 'string' || !args[i] || args[i].startsWith('--')) throw new Error('Option value is required')
    return args[i]
  }
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--smoke') opts.smoke = true
    else if (args[i] === '--full') opts.full = true
    else if (args[i] === '--repetitions') opts.repetitions = Number(value(++i))
    else if (args[i] === '--budget-tokens') opts.budgetTokens = Number(value(++i))
    else if (args[i] === '--prior-results') opts.priorResults = value(++i)
    else if (args[i] === '--continue-from') opts.continueFrom = value(++i)
    else throw new Error('usage: node bin/devflow-codex-eval --smoke|--full --budget-tokens <n> [--repetitions <1..1000>] [--prior-results <result.json> | --continue-from <budget-stopped full result.json>]')
  }
  if (opts.smoke === opts.full || !Number.isSafeInteger(opts.budgetTokens) || opts.budgetTokens <= 0) throw new Error('Choose exactly one mode and an explicit positive token budget')
  if (!Number.isSafeInteger(opts.repetitions) || opts.repetitions < 1 || opts.repetitions > 1000 || (opts.smoke && opts.repetitions !== 1)) throw new Error('Repetitions must be 1..1000; smoke runs its two cases once')
  if (opts.continueFrom && (!opts.full || opts.priorResults)) throw new Error('Continuation requires full mode and cannot also use prior-results')
  return opts
}

function expandCases(cases, repetitions) {
  if (!Number.isSafeInteger(repetitions) || repetitions < 1 || repetitions > 1000) throw new Error('Invalid repetitions')
  return Array.from({ length: repetitions }, (_, index) => cases.map(c => ({ ...c, repetition: index + 1 }))).flat()
}

function continuation(prior, cases, repetitions = 1) {
  if (prior.mode !== 'full' || prior.complete !== false || prior.stoppedReason !== 'budget' || prior.model !== MODEL || prior.effort !== EFFORT || prior.timeoutSeconds !== TIMEOUT / 1000 ||
    (prior.repetitions ?? 1) !== repetitions || !safeNumber(prior.priorTokens) || !Array.isArray(prior.cases) || !prior.cases.length || prior.cases.length >= cases.length) throw new Error('Only an incomplete full run stopped by budget with the same repetitions can continue')
  for (const [i, old] of prior.cases.entries()) {
    const expected = cases[i]
    if (old.id !== expected.id || (old.repetition ?? 1) !== (expected.repetition ?? 1) || old.promptHash !== expected.promptHash || old.expectedSkill !== expected.expectedSkill || old.policy !== expected.policy ||
      old.spawnFailed || !old.tokens || !safeNumber(old.tokens.total_tokens)) throw new Error('Continuation cases, policy or usage do not match')
  }
  const summary = summarize(prior.cases)
  if (!prior.summary?.usageKnown || prior.summary.totalTokens !== summary.totalTokens) throw new Error('Continuation usage is inconsistent')
  return { cases: prior.cases, priorTokens: prior.priorTokens, sourceHash: prior.sourceHash }
}

function continuationConditions(prior, current) {
  for (const key of ['version', 'runnerHash', 'sourceHash', 'globalInstructionsHash', 'catalogHash']) {
    if (!prior[key] || prior[key] !== current[key]) throw new Error('Continuation Codex version, runner code, installed skills, global instructions or skill catalog changed (' + key + ')')
  }
}

// The run measures the installed plugin, so it has to be the repository's skills, byte for byte.
function skillSnapshot(dir) {
  const hash = crypto.createHash('sha256')
  const walk = relative => {
    for (const name of fs.readdirSync(path.join(dir, relative)).sort()) {
      const entry = relative ? relative + '/' + name : name
      const stat = fs.lstatSync(path.join(dir, entry))
      if (stat.isDirectory()) walk(entry)
      else if (stat.isFile()) hash.update(entry).update('\0').update(fs.readFileSync(path.join(dir, entry))).update('\0')
      else throw new Error('Skill snapshot holds a link or special file: ' + entry)
    }
  }
  walk('')
  return hash.digest('hex')
}

function checkInstalled(repoSkills, installedSkills) {
  const expected = skillSnapshot(repoSkills)
  if (skillSnapshot(installedSkills) !== expected) throw new Error('The installed devflow skills differ from this repository; update the installed copy before measuring')
  return expected
}

// Global instructions stay as the host loads them; a change during the run would change what is measured.
function globalInstructionsHash(home) {
  const hash = crypto.createHash('sha256')
  for (const name of ['AGENTS.override.md', 'AGENTS.md']) {
    const file = path.join(home, name)
    hash.update(name).update('\0').update(fs.existsSync(file) ? fs.readFileSync(file) : '').update('\0')
  }
  return hash.digest('hex')
}

// The host config stays untouched: writes are blocked and the measured model is fixed per run on the command line.
// The working folder reaches the model as <cwd>, and Codex loads AGENTS.md from the project root down to it. Case folders
// therefore live outside this repository under position-only names, and no parent folder's AGENTS.md is loaded.
// They are untrusted, which is safe here: codex-cli 0.160.0 records trust for a new folder only when the run may write
// to it (app-server thread_processor.rs), and these runs are read-only.
const CONTEXT_OVERRIDES = ['-c', 'project_root_markers=[]']
const taskRoot = () => os.tmpdir()
// The preflight also runs in an untrusted temp folder, so it is pinned read-only like the cases.
const preflightArgs = () => ['debug', 'prompt-input', '-c', 'sandbox_mode="read-only"', ...CONTEXT_OVERRIDES]
function checkOutsideRepo(dir) {
  const rel = path.relative(ROOT, dir)
  if (!rel.startsWith('..') && !path.isAbsolute(rel)) throw new Error('Case folders must be outside this repository; the temp folder is inside it')
}
const caseDir = (taskDir, index) => path.join(taskDir, 't' + String(index + 1).padStart(2, '0'))

function execArgs() {
  return ['exec', '--json', '--ephemeral', '--skip-git-repo-check', '--sandbox', 'read-only', '-m', MODEL, '-c', 'model_reasoning_effort=' + JSON.stringify(EFFORT), ...CONTEXT_OVERRIDES, '-']
}

function cleanEnv(home) {
  const env = { CODEX_HOME: home, NoDefaultCurrentDirectoryInExePath: '1' }
  for (const k of ['PATH', 'Path', 'SystemRoot', 'WINDIR', 'COMSPEC', 'PATHEXT', 'TEMP', 'TMP', 'USERPROFILE', 'APPDATA', 'LOCALAPPDATA', 'HOME', 'LANG']) {
    if (process.env[k] !== undefined) env[k] = process.env[k]
  }
  return env
}

function runLocal(args, options) {
  const result = spawnSync('codex', args, { ...options, encoding: 'utf8', timeout: 30000, maxBuffer: MAX_OUTPUT, windowsHide: true })
  if (result.status !== 0) throw new Error('Codex preflight failed (exit ' + result.status + '): ' +
    String(result.stderr || result.error?.code || '').replace(/(?<![A-Za-z])[A-Za-z]:[\\/][^\r\n|]+/g, '<local-path>').slice(0, 500))
  return result.stdout
}

// Free check before any model call: the native prompt lists all seven devflow skills.
function preflight(cwd, env, names) {
  const text = JSON.stringify(JSON.parse(runLocal(preflightArgs(), { cwd, env })))
  const catalog = [...new Set([...text.matchAll(/- ([\w:-]+): /g)].map(m => m[1]))].sort()
  const missing = names.filter(n => !catalog.includes('devflow:' + n))
  if (missing.length) throw new Error('The native prompt does not list devflow skills: ' + missing.join(', '))
  return catalog
}

function execute(c, cwd, env, skillRoot, limits = {}) {
  return new Promise(resolve => {
    const start = Date.now()
    const before = new Set(fs.readdirSync(cwd))
    let stdout = '', size = 0, timedOut = false, overflow = false, spawnFailed = false, stopped = false, finished = false, stopWatchdog
    const child = spawn(limits.executable || 'codex', execArgs(),
      { cwd, env, windowsHide: true, detached: process.platform !== 'win32', stdio: ['pipe', 'pipe', 'ignore'] })
    const stop = () => {
      if (stopped || !child.pid) return
      stopped = true
      if (process.platform === 'win32') {
        const killed = spawnSync('taskkill.exe', ['/PID', String(child.pid), '/T', '/F'], { windowsHide: true, encoding: 'utf8', timeout: 10000 })
        if (killed.status !== 0) spawnFailed = true
      } else { try { process.kill(-child.pid, 'SIGKILL') } catch (e) { if (e.code !== 'ESRCH') spawnFailed = true } }
      stopWatchdog = setTimeout(() => {
        spawnFailed = true
        child.stdout.destroy()
        child.stdin.destroy()
        child.unref()
        finish(null, true)
      }, 5000)
    }
    const timer = setTimeout(() => { timedOut = true; stop() }, limits.timeoutMs ?? TIMEOUT)
    child.stdout.setEncoding('utf8')
    child.stdout.on('data', chunk => { size += Buffer.byteLength(chunk); if (size > MAX_OUTPUT) { overflow = true; stop() } else stdout += chunk })
    child.on('error', () => { spawnFailed = true })
    child.stdin.on('error', () => {})
    child.stdin.end(c.prompt)
    const finish = (exitCode, processStopUnconfirmed = false) => {
      if (finished) return
      finished = true
      clearTimeout(timer)
      clearTimeout(stopWatchdog)
      const trace = parseTrace(stdout, skillRoot)
      // The case folder is the run's writable root unless the sandbox holds; anything new in it means it did not.
      const cwdMissing = !fs.existsSync(cwd)
      const cwdWrites = cwdMissing ? 0 : fs.readdirSync(cwd).filter(n => !before.has(n)).length
      trace.valid = trace.valid && exitCode === 0 && !timedOut && !overflow && !spawnFailed && !cwdMissing && cwdWrites === 0
      resolve({ id: c.id, repetition: c.repetition ?? 1, expectedSkill: c.expectedSkill, policy: c.policy, promptHash: c.promptHash,
        detectedSkills: trace.detectedSkills, result: score(c, trace), tokens: trace.usage, durationMs: Date.now() - start,
        exitCode, timedOut, overflow, spawnFailed, processStopUnconfirmed, ...(processStopUnconfirmed ? { processId: child.pid } : {}),
        cwdWrites, cwdMissing, commands: trace.commands })
    }
    child.on('close', exitCode => finish(exitCode))
  })
}

async function main(args) {
  const opts = parseArgs(args)
  const cases = loadCases(path.join(ROOT, 'evals', 'trigger'))
  if (cases.length !== 24) throw new Error('Expected the same 24 Claude trigger cases')
  const selected = expandCases(opts.smoke ? ['grilling--grill-en', 'none--trivia-en'].map(id => cases.find(c => c.id === id)) : cases, opts.repetitions)
  const home = process.env.CODEX_HOME || path.join(os.homedir(), '.codex')
  const env = cleanEnv(home)
  const pluginVersion = JSON.parse(fs.readFileSync(path.join(ROOT, '.codex-plugin', 'plugin.json'), 'utf8')).version
  const skillRoot = path.join(home, 'plugins', 'cache', 'devflow', 'devflow', pluginVersion, 'skills')
  const names = fs.readdirSync(path.join(ROOT, 'skills')).sort()
  const current = {
    version: runLocal(['--version'], { cwd: ROOT, env }).trim(),
    runnerHash: crypto.createHash('sha256').update(fs.readFileSync(__filename)).digest('hex'),
    sourceHash: checkInstalled(path.join(ROOT, 'skills'), skillRoot),
    globalInstructionsHash: globalInstructionsHash(home),
  }
  checkOutsideRepo(taskRoot())
  const preflightDir = fs.mkdtempSync(path.join(taskRoot(), 'cx-'))
  let catalog
  try { catalog = preflight(preflightDir, env, names) } finally { fs.rmSync(preflightDir, { recursive: true, force: true }) }
  current.catalogHash = crypto.createHash('sha256').update(JSON.stringify(catalog)).digest('hex')
  let priorTokens = 0
  let continued = null
  if (opts.priorResults || opts.continueFrom) {
    const priorPath = path.resolve(ROOT, opts.priorResults || opts.continueFrom)
    const resultsRoot = path.join(ROOT, 'evals', 'results') + path.sep
    if (!priorPath.startsWith(resultsRoot) || !fs.lstatSync(priorPath).isFile() || fs.realpathSync(priorPath) !== priorPath) throw new Error('Prior results must be a regular file inside evals/results')
    const prior = JSON.parse(fs.readFileSync(priorPath, 'utf8'))
    if (prior.model !== MODEL || prior.effort !== EFFORT || !prior.summary?.usageKnown || !safeNumber(prior.summary.totalTokens)) throw new Error('Prior result usage or environment does not match')
    if (opts.continueFrom) {
      continuationConditions(prior, current)
      continued = continuation(prior, selected, opts.repetitions)
    }
    priorTokens = continued ? continued.priorTokens : prior.priorTokens + prior.summary.totalTokens
    const charged = prior.priorTokens + prior.summary.totalTokens
    if (!safeNumber(priorTokens) || !safeNumber(charged) || charged >= opts.budgetTokens) throw new Error('Prior usage already exhausted the budget')
  }
  const taskDir = fs.mkdtempSync(path.join(taskRoot(), 'cx-'))
  const resultDir = path.join(ROOT, 'evals', 'results', new Date().toISOString().replace(/[:.]/g, '-') + '-codex-' + (opts.smoke ? 'smoke' : 'full'))
  fs.mkdirSync(resultDir, { recursive: true })
  const report = { host: 'codex', ...current, model: MODEL, effort: EFFORT, sandbox: 'read-only', codexHome: 'real', timeoutSeconds: TIMEOUT / 1000,
    mode: opts.smoke ? 'smoke' : 'full', budgetTokens: opts.budgetTokens, priorTokens, repetitions: opts.repetitions, catalog,
    runner: 'devflow-codex-eval', startedAt: new Date().toISOString(),
    ...(continued ? { continuedFrom: normalize(path.relative(ROOT, path.resolve(ROOT, opts.continueFrom))), continuedAtCase: continued.cases.length } : {}),
    cases: continued ? [...continued.cases] : [], summary: summarize(continued ? continued.cases : []), complete: false, stoppedReason: null }
  const save = () => fs.writeFileSync(path.join(resultDir, 'result.json'), JSON.stringify(report, null, 2) + '\n')
  save()
  let keep = false
  try {
  const start = continued ? continued.cases.length : 0
  for (const [offset, c] of selected.slice(start).entries()) {
    if (!report.summary.usageKnown || priorTokens + report.summary.totalTokens >= opts.budgetTokens) { report.stoppedReason = report.summary.usageKnown ? 'budget' : 'unknown-usage'; break }
    if (globalInstructionsHash(home) !== current.globalInstructionsHash) { report.stoppedReason = 'global-instructions-changed'; break }
    const cwd = caseDir(taskDir, start + offset)
    fs.mkdirSync(cwd)
    const result = await execute(c, cwd, env, skillRoot)
    report.cases.push(result)
    report.summary = summarize(report.cases)
    save()
    process.stdout.write(c.id + ' [' + c.repetition + '/' + opts.repetitions + ']: ' + result.result + ', ' + (result.tokens?.total_tokens ?? 'unknown') + ' tokens, ' + (result.durationMs / 1000).toFixed(1) + 's\n')
    if (result.spawnFailed) { report.stoppedReason = 'process-stop-unconfirmed'; keep = true; break }
    if (result.cwdWrites || result.cwdMissing) { report.stoppedReason = 'sandbox-write'; keep = true; break }
  }
  report.complete = report.cases.length === selected.length
  report.finishedAt = new Date().toISOString()
  if (!report.summary.usageKnown && !report.stoppedReason) report.stoppedReason = 'unknown-usage'
  save()
  } finally {
  // Every folder here was created empty by this run and checked empty after its case; keep them only as evidence of a failure.
  if (keep) process.stderr.write('Case folders are kept for inspection in ' + normalize(taskDir) + '\n')
  else fs.rmSync(taskDir, { recursive: true, force: true })
  }
  process.stdout.write('Result: ' + normalize(path.relative(ROOT, path.join(resultDir, 'result.json'))) + '\n')
  if (!report.complete || report.summary.invalid || !report.summary.thresholdPassed) process.exitCode = 1
}

module.exports = { parseTrace, loadCases, score, parseArgs, summarize, cleanEnv, preflight, execute, execArgs, skillSnapshot, checkInstalled, caseDir, taskRoot, preflightArgs, checkOutsideRepo, globalInstructionsHash, continuation, continuationConditions, expandCases }
if (require.main === module) main(process.argv.slice(2)).catch(e => { process.stderr.write(e.message + '\n'); process.exitCode = 1 })
