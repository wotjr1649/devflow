{
  "integration": "local-merge",
  "branch": "{type}/{issue}-{slug}",
  "private": [
    "docs/prompts/",
    "docs/plans/",
    "artifacts/",
    ".work/",
    "_ref/"
  ],
  "protected": [
    "_ref/**"
  ],
  "highRisk": [
    "bin/**",
    "hooks/**",
    ".githooks/**"
  ],
  "checks": {
    "**/*.md": "node bin/devflow-doctor",
    "bin/**": "node --test --test-timeout=120000 tests/*.test.js",
    "tests/**": "node --test --test-timeout=120000 tests/*.test.js",
    "hooks/**": "node --test --test-timeout=120000 tests/*.test.js",
    "agents/**": "node --test --test-timeout=120000 tests/*.test.js",
    ".githooks/**": "node bin/devflow-doctor && node --test --test-timeout=120000 tests/*.test.js"
  },
  "verify": "node bin/devflow-doctor && node --test --test-timeout=120000 tests/*.test.js"
}
