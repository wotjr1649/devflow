{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/devflow-hook.js').main()\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/devflow-hook.js').main()\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
