#!/usr/bin/env node
'use strict'
// Opt-in trigger measurement. Contract: docs/specs/lifecycle.md#eval. Never reads session archives.
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')
const crypto = require('node:crypto')
const { spawn, spawnSync } = require('node:child_process')
const ROOT = path.resolve(__dirname, '..')
const MODEL = 'gpt-6.1-sol'
const EFFORT = 'high'
const TIMEOUT = 300000
const MAX_OUTPUT = 8 * 1024 * 1024
const normalize = s => s.replaceAll('\\', '/').replace(/\/+$/, '')
const toml = s => JSON.stringify(normalize(s))
const usageKeys = ['input_tokens', 'cached_input_tokens', 'output_tokens']
const safeNumber = n => Number.isSafeInteger(n) && n >= 0

function parseTrace(text, skillRoot) {
  const detected = new Set()
  const usage = Object.fromEntries([...usageKeys, 'total_tokens'].map(k => [k, 0]))
  let turns = 0, started = false, broken = false
  const commands = new Set()
  const fold = s => process.platform === 'win32' || /^[a-z]:\//i.test(normalize(skillRoot)) ? s.toLowerCase() : s
  const root = fold(normalize(skillRoot)) + '/'
  for (const line of text.split(/\r?\n/).filter(l => l.trim())) {
    let event
    try { event = JSON.parse(line) } catch { broken = true; continue }
    if (!event || typeof event !== 'object') { broken = true; continue }
    if (event.type === 'thread.started') started = true
    if (event.type === 'error' || event.type === 'turn.failed') broken = true
    if (event.type === 'turn.completed') {
      if (!event.usage || usageKeys.some(k => !safeNumber(event.usage[k])) || event.usage.cached_input_tokens > event.usage.input_tokens) {
        broken = true
        continue
      }
      turns++
      for (const k of usageKeys) usage[k] += event.usage[k]
      usage.total_tokens += event.usage.input_tokens + event.usage.output_tokens
    }
    if (!/^item\./.test(event.type || '') || event.item?.type !== 'command_execution' || typeof event.item.command !== 'string') continue
    commands.add(event.item.id || event.item.command)
    // Literal read operations only. Messages, command output, listings and echoed paths are not trigger evidence.
    const command = normalize(event.item.command)
    const unwrapped = command.replace(/^(?:"[^"]+"|[^\s]+)\s+(?:-[\w-]+\s+)*-(?:Command|lc|c)\s+["']?/i, '')
    if (!/^(?:Get-Content|cat|head|tail|sed|readFileSync|readFile|read_text)\b/i.test(unwrapped)) continue
    // Tokenize literal operands of the first read; quoted echo text and later commands are data.
    const operands = unwrapped.replace(/^(?:Get-Content|cat|head|tail|sed|readFileSync|readFile|read_text)\b/i, '')
    for (const m of operands.matchAll(/'([^']*)'|"([^"]*)"|([;|&])|([^\s'";|&]+)/g)) {
      if (m[3]) break
      const file = m[1] ?? m[2] ?? m[4]
      const key = fold(file)
      if (!key.startsWith(root)) continue
      const relative = file.slice(root.length)
      if (/^[A-Za-z0-9_.-]+\/SKILL\.md$/i.test(relative)) detected.add(fold(relative.split('/')[0]))
    }
  }
  return { detectedSkills: [...detected].sort(), usage: turns ? usage : null, commandExecutions: commands.size, valid: started && turns > 0 && !broken }
}

function loadCases(dir) {
  return fs.readdirSync(dir).sort().map(id => {
    if (!/^[a-z][a-z-]*--[a-z][a-z-]*$/.test(id)) throw new Error('Invalid case name')
    const file = path.join(dir, id, 'prompt.md')
    if (!fs.lstatSync(file).isFile()) throw new Error('Case is not a regular file')
    const text = fs.readFileSync(file, 'utf8')
    const fm = /^---\r?\n([\s\S]*?)\r?\n---\r?\n/.exec(text)
    if (!fm || !fm[1].includes('tags: [trigger,')) throw new Error('Missing trigger metadata')
    const graders = fs.readdirSync(path.join(dir, id, 'graders'))
    if (graders.length !== 1) throw new Error('Expected one trigger grader')
    const grader = fs.readFileSync(path.join(dir, id, 'graders', graders[0]), 'utf8')
    const target = id.split('--')[0]
    const policy = target === 'none' ? 'none' : /^max: 0\r?$/m.test(grader) ? 'forbidden' : 'required'
    if (!grader.includes('devflow:') || (target !== 'none' && !grader.includes('devflow:' + target))) throw new Error('Case and grader disagree')
    return { id, expectedSkill: target === 'none' ? null : target, policy, prompt: text.slice(fm[0].length), promptHash: crypto.createHash('sha256').update(text).digest('hex') }
  })
}

function score(c, trace) {
  if (!trace.valid) return 'invalid'
  const hit = trace.detectedSkills.includes(c.expectedSkill)
  return (c.policy === 'none' ? trace.detectedSkills.length === 0 : c.policy === 'forbidden' ? !hit : hit) ? 'pass' : 'fail'
}

function summarize(cases) {
  const valid = cases.filter(c => c.result !== 'invalid')
  const positives = valid.filter(c => c.policy === 'required')
  const negatives = valid.filter(c => c.policy !== 'required')
  const triggerRate = positives.length ? positives.filter(c => c.result === 'pass').length / positives.length : null
  const falsePositiveRate = negatives.length ? negatives.filter(c => c.result === 'fail').length / negatives.length : null
  return { attempted: cases.length, passed: valid.filter(c => c.result === 'pass').length, failed: valid.filter(c => c.result === 'fail').length,
    invalid: cases.length - valid.length, triggerRate, falsePositiveRate,
    totalTokens: cases.reduce((n, c) => n + (c.tokens?.total_tokens || 0), 0), usageKnown: cases.every(c => c.tokens !== null),
    thresholdPassed: triggerRate !== null && falsePositiveRate !== null && triggerRate >= 0.8 && falsePositiveRate <= 0.1 }
}

function parseArgs(args) {
  const opts = { smoke: false, full: false, budgetTokens: null, priorResults: null, continueFrom: null }
  const value = i => {
    if (typeof args[i] !== 'string' || !args[i] || args[i].startsWith('--')) throw new Error('Option value is required')
    return args[i]
  }
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--smoke') opts.smoke = true
    else if (args[i] === '--full') opts.full = true
    else if (args[i] === '--budget-tokens') opts.budgetTokens = Number(value(++i))
    else if (args[i] === '--prior-results') opts.priorResults = value(++i)
    else if (args[i] === '--continue-from') opts.continueFrom = value(++i)
    else throw new Error('usage: node bin/devflow-codex-eval --smoke|--full --budget-tokens <n> [--prior-results <result.json> | --continue-from <budget-stopped full result.json>]')
  }
  if (opts.smoke === opts.full || !Number.isSafeInteger(opts.budgetTokens) || opts.budgetTokens <= 0) throw new Error('Choose exactly one mode and an explicit positive token budget')
  if (opts.continueFrom && (!opts.full || opts.priorResults)) throw new Error('Continuation requires full mode and cannot also use prior-results')
  return opts
}

function continuation(prior, cases) {
  if (prior.mode !== 'full' || prior.complete !== false || prior.stoppedReason !== 'budget' || prior.model !== MODEL || prior.effort !== EFFORT || prior.timeoutSeconds !== TIMEOUT / 1000 ||
    !safeNumber(prior.priorTokens) || !Array.isArray(prior.cases) || !prior.cases.length || prior.cases.length >= cases.length) throw new Error('Only an incomplete full run stopped by budget can continue')
  for (const [i, old] of prior.cases.entries()) {
    const expected = cases[i]
    if (old.id !== expected.id || old.promptHash !== expected.promptHash || old.expectedSkill !== expected.expectedSkill || old.policy !== expected.policy ||
      old.guardMissing || old.spawnFailed || !old.tokens || !safeNumber(old.tokens.total_tokens)) throw new Error('Continuation cases, policy, usage or isolation do not match')
  }
  const summary = summarize(prior.cases)
  if (!prior.summary?.usageKnown || prior.summary.totalTokens !== summary.totalTokens) throw new Error('Continuation usage is inconsistent')
  return { cases: prior.cases, priorTokens: prior.priorTokens, sourceHash: prior.sourceHash }
}

function systemSkills(home) {
  const disabled = []
  for (const base of [path.join(os.homedir(), '.agents', 'skills'), path.join(home, 'skills', '.system')]) {
    if (!fs.existsSync(base)) continue
    for (const name of fs.readdirSync(base)) disabled.push(path.join(base, name, 'SKILL.md'))
  }
  // Codex seeds these bundled skills on first use of a fresh home.
  for (const name of ['skill-creator', 'skill-installer', 'openai-docs', 'imagegen']) disabled.push(path.join(home, 'skills', '.system', name, 'SKILL.md'))
  return [...new Set(disabled)]
}

function configArgs(home) {
  const publicRoot = path.join(home, 'plugins', 'cache', 'devflow', 'devflow', '0.1.0')
  const settings = [
    'model=' + toml(MODEL), 'model_reasoning_effort=' + toml(EFFORT), 'approval_policy="never"',
    'default_permissions="eval"',
    'permissions.eval.filesystem={":minimal"="read",' + toml(path.join(publicRoot, 'skills')) + '="read",' + toml(path.join(publicRoot, 'docs')) + '="read"}',
    'permissions.eval.network.enabled=false', 'windows.sandbox="elevated"',
    'features.hooks=true', 'features.code_mode=false', 'features.apps=false', 'features.multi_agent=false', 'features.memories=false', 'features.shell_snapshot=false', 'web_search="disabled"',
    'shell_environment_policy.inherit="none"', 'shell_environment_policy.experimental_use_profile=false',
    'skills.config=[' + systemSkills(home).map(p => '{path=' + toml(p) + ',enabled=false}').join(',') + ']',
  ]
  return settings.flatMap(s => ['-c', s])
}

function cleanEnv(home) {
  const env = { CODEX_HOME: home, NoDefaultCurrentDirectoryInExePath: '1' }
  for (const k of ['PATH', 'Path', 'SystemRoot', 'WINDIR', 'COMSPEC', 'PATHEXT', 'TEMP', 'TMP', 'USERPROFILE', 'APPDATA', 'LOCALAPPDATA', 'HOME', 'LANG']) {
    if (process.env[k] !== undefined) env[k] = process.env[k]
  }
  return env
}

function runLocal(args, options) {
  const result = spawnSync('codex', args, { ...options, encoding: 'utf8', timeout: 30000, maxBuffer: MAX_OUTPUT, windowsHide: true })
  if (result.status !== 0) throw new Error('Codex preflight failed (exit ' + result.status + '): ' +
    String(result.stderr || result.error?.code || '').replace(/(?<![A-Za-z])[A-Za-z]:[\\/][^\r\n|]+/g, '<local-path>').slice(0, 500))
  return result.stdout
}

function guardCommand(home) {
  const quote = process.platform === 'win32' ? s => "'" + s.replaceAll("'", "''") + "'" : s => "'" + s.replaceAll("'", "'\\''") + "'"
  const args = [process.execPath, path.join(home, 'eval-guard.cjs'), home].map(quote).join(' ')
  // Codex uses the thread's shell for hooks; Windows evaluation uses PowerShell.
  return (process.platform === 'win32' ? '& ' : '') + args
}

function checkGuardCommand(home, cwd, env) {
  const publicRoot = JSON.parse(fs.readFileSync(path.join(home, 'eval-public-root.json'), 'utf8')).root
  const file = path.join(publicRoot, 'skills', 'grilling', 'SKILL.md')
  const auditFile = path.join(home, 'eval-guard-audit.jsonl')
  const before = fs.existsSync(auditFile) ? fs.readFileSync(auditFile, 'utf8').split('\n').filter(Boolean).length : 0
  for (const [command, expected] of [["Get-Content -LiteralPath '" + file + "' -Raw", 'allow'], ['whoami', 'deny'], ["Get-Content '" + path.join(home, 'auth.json') + "'", 'deny']]) {
    const shell = process.platform === 'win32' ? ['pwsh.exe', ['-NoProfile', '-NonInteractive', '-Command', guardCommand(home)]] : ['sh', ['-c', guardCommand(home)]]
    const run = spawnSync(shell[0], shell[1], { cwd, env, input: JSON.stringify({ hook_event_name: 'PreToolUse', tool_name: 'Bash', tool_input: { command } }), encoding: 'utf8', timeout: 3000, maxBuffer: 65536, windowsHide: true })
    let decision
    try { decision = JSON.parse(run.stdout).hookSpecificOutput.permissionDecision } catch {}
    if (run.status !== 0 || decision !== expected) throw new Error('Evaluation guard shell canary failed before model execution')
  }
  const audit = fs.readFileSync(auditFile, 'utf8').split('\n').filter(Boolean).slice(before).map(l => JSON.parse(l))
  if (JSON.stringify(audit) !== JSON.stringify([{ allowed: true }, { allowed: false }, { allowed: false }])) throw new Error('Evaluation guard shell audit is incomplete')
}

function prepare(root, taskDir) {
  const home = path.join(taskDir, 'home')
  const publicRoot = path.join(taskDir, 'plugin')
  fs.mkdirSync(home)
  const sourceHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex')
  // Reuse credential bytes without copying them. Never include the auth link in readable roots or result artifacts.
  const auth = path.join(sourceHome, 'auth.json')
  if (!fs.lstatSync(auth).isFile()) throw new Error('Existing file authentication is required; no login or credential installation is performed')
  fs.symlinkSync(auth, path.join(home, 'auth.json'), 'file')
  if (process.platform === 'win32') {
    if (!fs.existsSync(path.join(sourceHome, '.sandbox', 'setup_marker.json'))) throw new Error('An existing elevated Windows sandbox is required; setup is not performed')
    for (const name of ['.sandbox', '.sandbox-secrets', '.sandbox-bin']) {
      const source = path.join(sourceHome, name)
      if (!fs.lstatSync(source).isDirectory()) throw new Error('Existing Windows sandbox state is incomplete')
      fs.symlinkSync(source, path.join(home, name), 'junction')
    }
  }
  const names = fs.readdirSync(path.join(root, 'skills')).sort()
  if (names.length !== 7) throw new Error('Expected seven devflow skills')
  const listed = spawnSync('git', ['ls-files', '-z', '--', 'skills', 'docs/specs', 'docs/research', 'docs/design/decisions'], { cwd: root, encoding: 'utf8', windowsHide: true })
  if (listed.status !== 0) throw new Error('Cannot inventory public source files')
  const hash = crypto.createHash('sha256')
  for (const relative of listed.stdout.split('\0').filter(Boolean)) {
    if (!/^(skills|docs\/(specs|research|design\/decisions))\//.test(relative) || relative.split('/').includes('..')) throw new Error('Invalid public snapshot path')
    const source = path.join(root, relative)
    if (!fs.lstatSync(source).isFile()) throw new Error('Snapshot source is not a regular file')
    const bytes = fs.readFileSync(source)
    const target = path.join(publicRoot, relative)
    fs.mkdirSync(path.dirname(target), { recursive: true })
    fs.writeFileSync(target, bytes, { flag: 'wx' })
    hash.update(relative).update('\0').update(bytes)
  }
  const init = spawnSync('git', ['-c', 'init.templateDir=', 'init', '--quiet', taskDir], { encoding: 'utf8', windowsHide: true })
  if (init.status !== 0) throw new Error('Cannot create isolated local project root')
  const marketplace = '.agents/plugins/marketplace.json'
  const manifest = '.codex-plugin/plugin.json'
  for (const relative of [marketplace, manifest]) {
    const source = fs.readFileSync(path.join(root, relative), 'utf8')
    const json = JSON.parse(source)
    if (relative === manifest) delete json.hooks
    fs.mkdirSync(path.dirname(path.join(publicRoot, relative)), { recursive: true })
    fs.writeFileSync(path.join(publicRoot, relative), JSON.stringify(json) + '\n', { flag: 'wx' })
    hash.update(relative).update('\0').update(JSON.stringify(json))
  }
  const env = cleanEnv(home)
  runLocal(['plugin', 'marketplace', 'add', publicRoot], { cwd: taskDir, env })
  runLocal(['plugin', 'add', 'devflow@devflow'], { cwd: taskDir, env })
  const loadedRoot = path.join(home, 'plugins', 'cache', 'devflow', 'devflow', '0.1.0')
  if (!fs.existsSync(path.join(loadedRoot, 'skills', 'devflow', 'SKILL.md'))) throw new Error('Isolated devflow cache is missing')
  fs.writeFileSync(path.join(home, 'eval-public-root.json'), JSON.stringify({ root: loadedRoot }))
  const guardFile = path.join(home, 'eval-guard.cjs')
  fs.copyFileSync(path.join(root, 'bin', 'devflow-codex-eval-guard'), guardFile, fs.constants.COPYFILE_EXCL)
  const command = guardCommand(home)
  fs.writeFileSync(path.join(home, 'hooks.json'), JSON.stringify({ hooks: { PreToolUse: [{ matcher: '.*', hooks: [{ type: 'command', command, timeout: 3 }] }] } }) + '\n')
  return { home, names, skillRoot: path.join(loadedRoot, 'skills'), sourceHash: hash.digest('hex') }
}

function hookMetadata(home, cwd, env) {
  return new Promise((resolve, reject) => {
    const child = spawn('codex', ['app-server', '--stdio', ...configArgs(home)], { cwd, env, windowsHide: true, stdio: ['pipe', 'pipe', 'ignore'] })
    let buffer = '', settled = false
    const end = (err, data) => {
      if (settled) return
      settled = true
      clearTimeout(timer)
      child.stdin.end()
      child.kill()
      err ? reject(err) : resolve(data)
    }
    const timer = setTimeout(() => end(new Error('Hook metadata lookup timed out')), 15000)
    child.on('error', () => end(new Error('Cannot start local hook metadata lookup')))
    child.on('exit', () => { if (!settled) end(new Error('Hook metadata lookup exited early')) })
    child.stdout.setEncoding('utf8')
    child.stdout.on('data', chunk => {
      buffer += chunk
      if (buffer.length > MAX_OUTPUT) return end(new Error('Hook metadata output too large'))
      let at
      while ((at = buffer.indexOf('\n')) >= 0) {
        const line = buffer.slice(0, at); buffer = buffer.slice(at + 1)
        let message; try { message = JSON.parse(line) } catch { return end(new Error('Invalid hook metadata JSON')) }
        if (message.error) return end(new Error('Hook metadata request failed'))
        if (message.id === 1) {
          child.stdin.write(JSON.stringify({ method: 'initialized', params: {} }) + '\n')
          child.stdin.write(JSON.stringify({ id: 2, method: 'hooks/list', params: { cwds: [cwd] } }) + '\n')
        } else if (message.id === 2) end(null, message.result)
      }
    })
    child.stdin.on('error', () => {})
    child.stdin.write(JSON.stringify({ id: 1, method: 'initialize', params: { clientInfo: { name: 'devflow-eval-preflight', version: '1' } } }) + '\n')
  })
}

async function trustGuard(home, cwd, env) {
  const metadata = await hookMetadata(home, cwd, env)
  const hooks = metadata.data?.flatMap(e => e.hooks) || []
  const command = guardCommand(home)
  if (hooks.length !== 1 || hooks[0].eventName !== 'preToolUse' || hooks[0].matcher !== '.*' || hooks[0].command !== command ||
    normalize(hooks[0].sourcePath) !== normalize(path.join(home, 'hooks.json')) || !/^sha256:[a-f0-9]{64}$/.test(hooks[0].currentHash)) throw new Error('Unexpected evaluation hook metadata')
  fs.appendFileSync(path.join(home, 'config.toml'), '\n[hooks.state.' + JSON.stringify(hooks[0].key) + ']\ntrusted_hash = ' + JSON.stringify(hooks[0].currentHash) + '\n')
  const verified = await hookMetadata(home, cwd, env)
  const trusted = verified.data?.flatMap(e => e.hooks) || []
  if (trusted.length !== 1 || !trusted[0].enabled || trusted[0].trustStatus !== 'trusted') throw new Error('Evaluation guard is not trusted and enabled')
  return { guardHash: hooks[0].currentHash, trusted: true }
}

async function preflight(home, names, taskDir, env) {
  const cwd = path.join(taskDir, 'preflight')
  fs.mkdirSync(cwd)
  const args = configArgs(home)
  const raw = runLocal(['debug', 'prompt-input', ...args], { cwd, env })
  const input = JSON.parse(raw)
  const text = JSON.stringify(input)
  const catalog = [...text.matchAll(/- ([\w:-]+): /g)].map(m => m[1].replace(/^devflow:/, '')).sort()
  if (JSON.stringify(catalog) !== JSON.stringify(names)) throw new Error('Preflight catalog is not exactly the seven devflow skills')
  // A fresh home and empty workspace supply no user instructions. Hooks are not disabled or bypassed.
  if (text.includes('Global Agent Operating Contract') || text.includes('recent context')) throw new Error('Private context present in preflight')
  const publicRoot = JSON.parse(fs.readFileSync(path.join(home, 'eval-public-root.json'), 'utf8')).root
  const allowed = path.join(publicRoot, 'skills', names[0], 'SKILL.md')
  const trusted = await trustGuard(home, cwd, env)
  checkGuardCommand(home, cwd, env)
  const guard = require('./devflow-codex-eval-guard')
  const allowedInput = { hook_event_name: 'PreToolUse', tool_name: 'Bash', tool_input: { command: "Get-Content -LiteralPath '" + allowed + "' -Raw" } }
  if (!guard.permits(allowedInput, publicRoot) || guard.permits({ ...allowedInput, tool_input: { command: "Get-Content '" + path.join(home, 'auth.json') + "'" } }, publicRoot) ||
    guard.permits({ ...allowedInput, tool_input: { command: 'whoami' } }, publicRoot)) throw new Error('Evaluation guard self-check failed')
  const command = process.platform === 'win32' ? ['pwsh.exe', '-NoProfile', '-NonInteractive', '-Command',
    "$ErrorActionPreference='Stop'; if (!(Test-Path -LiteralPath '" + allowed.replaceAll("'", "''") + "')) { exit 11 }; try { Set-Content -LiteralPath 'write-canary.txt' -Value 'test'; exit 13 } catch {}; try { [void](Invoke-WebRequest -Uri 'https://example.com' -TimeoutSec 3); exit 14 } catch {}; Write-Output 'isolation-ok'"] :
    ['sh', '-c', 'test -r "$1" && ! touch write-canary && ! curl --max-time 3 https://example.com >/dev/null 2>&1', 'sh', allowed]
  runLocal(['sandbox', '-P', 'eval', ...args, ...command], { cwd, env })
  if (fs.existsSync(path.join(cwd, 'write-canary.txt'))) throw new Error('Sandbox write denial failed')
  const denied = path.join(home, 'private-read-canary.txt')
  fs.writeFileSync(denied, 'Public canary outside the allowed snapshot; no credentials.')
  const readProbe = process.platform === 'win32' ? ['pwsh.exe', '-NoProfile', '-NonInteractive', '-Command',
    "try { [void](Get-Content -LiteralPath '" + denied.replaceAll("'", "''") + "' -ErrorAction Stop); exit 19 } catch { Write-Output 'read-denied' }"] :
    ['sh', '-c', 'if cat "$1" >/dev/null 2>&1; then exit 19; fi', 'sh', denied]
  runLocal(['sandbox', '-P', 'eval', ...args, ...readProbe], { cwd, env })
  return { catalog, privateContext: false, sandboxChecked: true, ...trusted, readBoundary: 'os-snapshot-read-allowlist-and-evaluation-hook' }
}

function execute(c, cwd, home, env, limits = {}) {
  return new Promise(resolve => {
    const start = Date.now()
    const auditFile = path.join(home, 'eval-guard-audit.jsonl')
    const auditBefore = fs.existsSync(auditFile) ? fs.readFileSync(auditFile, 'utf8').split('\n').filter(Boolean).length : 0
    let stdout = '', size = 0, timedOut = false, overflow = false, spawnFailed = false, stopped = false, finished = false, stopWatchdog
    const child = spawn(limits.executable || 'codex', ['exec', '--json', '--ephemeral', '--skip-git-repo-check', ...configArgs(home), '-'],
      { cwd, env, windowsHide: true, detached: process.platform !== 'win32', stdio: ['pipe', 'pipe', 'ignore'] })
    const stop = () => {
      if (stopped || !child.pid) return
      stopped = true
      if (process.platform === 'win32') {
        const killed = spawnSync('taskkill.exe', ['/PID', String(child.pid), '/T', '/F'], { windowsHide: true, encoding: 'utf8', timeout: 10000 })
        if (killed.status !== 0) spawnFailed = true
      } else { try { process.kill(-child.pid, 'SIGKILL') } catch (e) { if (e.code !== 'ESRCH') spawnFailed = true } }
      stopWatchdog = setTimeout(() => {
        spawnFailed = true
        child.stdout.destroy()
        child.stdin.destroy()
        child.unref()
        finish(null, true)
      }, 5000)
    }
    const timer = setTimeout(() => { timedOut = true; stop() }, limits.timeoutMs ?? TIMEOUT)
    child.stdout.setEncoding('utf8')
    child.stdout.on('data', chunk => { size += Buffer.byteLength(chunk); if (size > MAX_OUTPUT) { overflow = true; stop() } else stdout += chunk })
    child.on('error', () => { spawnFailed = true })
    child.stdin.on('error', () => {})
    child.stdin.end(c.prompt)
    const finish = (exitCode, processStopUnconfirmed = false) => {
      if (finished) return
      finished = true
      clearTimeout(timer)
      clearTimeout(stopWatchdog)
      const publicRoot = JSON.parse(fs.readFileSync(path.join(home, 'eval-public-root.json'), 'utf8')).root
      const trace = parseTrace(stdout, path.join(publicRoot, 'skills'))
      const audit = fs.existsSync(auditFile) ? fs.readFileSync(auditFile, 'utf8').split('\n').filter(Boolean).slice(auditBefore).map(l => JSON.parse(l)) : []
      const guardMissing = trace.commandExecutions > 0 && audit.length < trace.commandExecutions
      trace.valid = trace.valid && exitCode === 0 && !timedOut && !overflow && !spawnFailed
      trace.valid = trace.valid && !guardMissing
      resolve({ id: c.id, expectedSkill: c.expectedSkill, policy: c.policy, promptHash: c.promptHash,
        detectedSkills: trace.detectedSkills, result: score(c, trace), tokens: trace.usage, durationMs: Date.now() - start,
        exitCode, timedOut, overflow, spawnFailed, processStopUnconfirmed, ...(processStopUnconfirmed ? { processId: child.pid } : {}),
        guardMissing, guardCalls: audit.length, guardAllowed: audit.filter(a => a.allowed).length,
        stdoutHash: crypto.createHash('sha256').update(stdout).digest('hex') })
    }
    child.on('close', exitCode => finish(exitCode))
  })
}

async function main(args) {
  const opts = parseArgs(args)
  const cases = loadCases(path.join(ROOT, 'evals', 'trigger'))
  if (cases.length !== 24) throw new Error('Expected the same 24 Claude trigger cases')
  const selected = opts.smoke ? ['grilling--grill-en', 'none--trivia-en'].map(id => cases.find(c => c.id === id)) : cases
  let priorTokens = 0
  let continued = null
  if (opts.priorResults || opts.continueFrom) {
    const priorPath = path.resolve(ROOT, opts.priorResults || opts.continueFrom)
    const resultsRoot = path.join(ROOT, 'evals', 'results') + path.sep
    if (!priorPath.startsWith(resultsRoot) || !fs.lstatSync(priorPath).isFile() || fs.realpathSync(priorPath) !== priorPath) throw new Error('Prior results must be a regular file inside evals/results')
    const prior = JSON.parse(fs.readFileSync(priorPath, 'utf8'))
    if (prior.model !== MODEL || prior.effort !== EFFORT || !prior.summary?.usageKnown || !safeNumber(prior.summary.totalTokens)) throw new Error('Prior result usage or environment does not match')
    if (opts.continueFrom) continued = continuation(prior, cases)
    priorTokens = continued ? continued.priorTokens : prior.priorTokens + prior.summary.totalTokens
    const charged = prior.priorTokens + prior.summary.totalTokens
    if (!safeNumber(priorTokens) || !safeNumber(charged) || charged >= opts.budgetTokens) throw new Error('Prior usage already exhausted the budget')
  }
  const version = runLocal(['--version'], { cwd: ROOT, env: cleanEnv(process.env.CODEX_HOME || path.join(os.homedir(), '.codex')) }).trim()
  const work = path.join(ROOT, '.work')
  fs.mkdirSync(work, { recursive: true })
  const taskDir = fs.mkdtempSync(path.join(work, 'codex-eval-'))
  let unconfirmedProcess = false
  try {
  const prepared = prepare(ROOT, taskDir)
  if (continued && continued.sourceHash !== prepared.sourceHash) throw new Error('Public skill/document snapshot changed; continuation would change the measurement target')
  const env = cleanEnv(prepared.home)
  const isolation = await preflight(prepared.home, prepared.names, taskDir, env)
  const resultDir = path.join(ROOT, 'evals', 'results', new Date().toISOString().replace(/[:.]/g, '-') + '-codex-' + (opts.smoke ? 'smoke' : 'full'))
  fs.mkdirSync(resultDir, { recursive: true })
  const report = { host: 'codex', version, model: MODEL, effort: EFFORT, timeoutSeconds: TIMEOUT / 1000, mode: opts.smoke ? 'smoke' : 'full',
    budgetTokens: opts.budgetTokens, priorTokens, sourceHash: prepared.sourceHash, isolation, startedAt: new Date().toISOString(),
    ...(continued ? { continuedFrom: normalize(opts.continueFrom), continuedAtCase: continued.cases.length } : {}),
    cases: continued ? [...continued.cases] : [], summary: summarize(continued ? continued.cases : []), complete: false, stoppedReason: null }
  const save = () => fs.writeFileSync(path.join(resultDir, 'result.json'), JSON.stringify(report, null, 2) + '\n')
  save()
  for (const c of selected.slice(continued ? continued.cases.length : 0)) {
    if (!report.summary.usageKnown || priorTokens + report.summary.totalTokens >= opts.budgetTokens) { report.stoppedReason = report.summary.usageKnown ? 'budget' : 'unknown-usage'; break }
    const cwd = path.join(taskDir, c.id)
    fs.mkdirSync(cwd)
    const result = await execute(c, cwd, prepared.home, env)
    if (result.processStopUnconfirmed) unconfirmedProcess = true
    report.cases.push(result)
    report.summary = summarize(report.cases)
    save()
    process.stdout.write(c.id + ': ' + result.result + ', ' + (result.tokens?.total_tokens ?? 'unknown') + ' tokens, ' + (result.durationMs / 1000).toFixed(1) + 's\n')
    if (result.spawnFailed) { report.stoppedReason = 'process-stop-unconfirmed'; break }
    if (result.guardMissing) { report.stoppedReason = 'guard-execution-unverified'; break }
  }
  report.complete = report.cases.length === selected.length
  report.finishedAt = new Date().toISOString()
  if (!report.summary.usageKnown && !report.stoppedReason) report.stoppedReason = 'unknown-usage'
  save()
  process.stdout.write('Result: ' + normalize(path.relative(ROOT, path.join(resultDir, 'result.json'))) + '\n')
  if (!report.complete || report.summary.invalid || !report.summary.thresholdPassed) process.exitCode = 1
  } finally {
  // Unlink only task-created references; never traverse or remove their credential/sandbox targets.
  if (unconfirmedProcess) process.stderr.write('Process stop is unconfirmed; task references are retained for caller recovery. No further case was started.\n')
  for (const name of ['auth.json', '.sandbox', '.sandbox-secrets', '.sandbox-bin']) {
    if (unconfirmedProcess) break
    const link = path.join(taskDir, 'home', name)
    try { if (fs.lstatSync(link).isSymbolicLink()) fs.unlinkSync(link) } catch (e) { if (e.code !== 'ENOENT') throw e }
  }
  }
}

module.exports = { parseTrace, loadCases, score, parseArgs, summarize, configArgs, cleanEnv, prepare, preflight, execute, hookMetadata, guardCommand, checkGuardCommand, continuation }
if (require.main === module) main(process.argv.slice(2)).catch(e => { process.stderr.write(e.message + '\n'); process.exitCode = 1 })
