#!/usr/bin/env node
'use strict'
// Checks a repository against docs/specs/repository.md and the document rules in docs/specs/documents.md.
// Read-only. Prints one line per finding, then "ok" (exit 0) or the failure count (exit 1); warnings do not fail.
const fs = require('fs')
const os = require('os')
const path = require('path')
const { spawnSync } = require('child_process')
// Windows looks for git.exe and gh.exe in the working folder before PATH; a cloned repository must not supply them.
if (process.platform === 'win32') process.env.NoDefaultCurrentDirectoryInExePath = '1'
const { INVISIBLE } = require('./devflow-state')

const MANAGED_IGNORE = ['/docs/prompts/', '/docs/plans/', '/artifacts/', '/.work/', '/_ref/', '/.claude/worktrees/',
  '/.claude/settings.local.json', 'CLAUDE.local.md']
const ATTRIBUTES = ['* text=auto eol=lf', '*.cmd text eol=crlf', '*.bat text eol=crlf', '*.png binary', '*.zip binary']
const PRIVATE = ['docs/prompts/', 'docs/plans/', 'artifacts/', '.work/', '_ref/']
// AGENTS.md is required unless the profile says it is private; the contract and decision folders can be moved (#23).
const REQUIRED = ['.devflow.json', '.github/ISSUE_TEMPLATE/intent.md']
const AGENTS_SECTIONS = ['## Commands', '## Boundaries']
const INSTRUCTION_SWITCHES = ['CLAUDE.md', '.claude/CLAUDE.md', 'CLAUDE.local.md']
const escapeRe = s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
// specs is the folder of devflow-style contracts, or null when the project keeps none (profile `"specs": false`).
const budgets = specs => [[/^AGENTS\.md$/, 1000], ...(specs ? [[new RegExp(`^${escapeRe(specs)}/.+\\.md$`), 5000]] : []), [/(^|\/)SKILL\.md$/, 5000]]
const PROMPT_BUDGET = 500
const INTEGRATIONS = ['pr-ci', 'local-merge', 'push-on-request']
const MAX_LINES_PER_RULE = 3
const PRIVATE_NAME =/^\d{4}-\d{2}-\d{2}-i\d+-[a-z0-9-]+-(prompt|plan|handoff)\.md$/
const LOCAL_PATH = /\b[A-Za-z]:[\\/]|(?:^|[\s'"`(=])\/[a-z]\/[^\s/]+\/|\/home\/[^/\s]+\/|\/Users\/[^/\s]+\//
// What a file in allowLocalPaths may still not hold: a path under a user's home names that user (#23).
const USER_PATH = /\b[A-Za-z]:[\\/]+(?:Users|Documents and Settings)[\\/]+[^\\/\s"'`]+|\/home\/[^/\s]+\/|\/Users\/[^/\s]+\//i
const globToRegExp = g => new RegExp('^' + g.split('**').map(part => part.split('*').map(x => x.replace(/[.+^${}()|[\]\\?]/g, '\\$&')).join('[^/]*')).join('.*') + '$')
const matchesGlob = (file, glob) => (path.posix.matchesGlob ? path.posix.matchesGlob(file, glob) : globToRegExp(glob).test(file))
// A folder the profile names: relative, inside the repository, forward slashes.
const insideFolder = v => typeof v === 'string' && v !== '' && !path.isAbsolute(v) && !/^[A-Za-z]:/.test(v) && !v.split(/[\\/]/).includes('..')
const EMPHASIS = /\b(MUST|CRITICAL|EXTREMELY|IMPORTANT|NEVER|ALWAYS)\b/g
const READ_LIST = /\b(read (this |these |the following )?(files )?first|always read|before (every|each) (edit|change|task)[^.\n]*read)\b/i
const DATED = /\b20\d\d-\d\d-\d\d\b|\b(in progress|work in progress|TODO)\b|진행 중/

// Rough token estimate shared with the budgets in docs/specs/documents.md: a Hangul syllable ~1 token, else ~4 chars.
const tokens = s => {
  const h = (s.match(/[가-힣]/g) || []).length
  return Math.round(h + (s.length - h) / 4)
}
const slug = h => h.trim().toLowerCase().replace(/[^\p{L}\p{N}\s-]/gu, '').replace(/\s/g, '-')

function git(root, args) {
  // core.quotePath=false: git otherwise quotes non-ASCII names, which then match no file on disk.
  const r = spawnSync('git', ['-C', root, '-c', 'core.quotePath=false', ...args], { encoding: 'utf8', windowsHide: true })
  return r.status === 0 ? r.stdout : null
}

const isFile = p => {
  try {
    return fs.statSync(p).isFile()
  } catch {
    return false
  }
}

// Checks the repository at dir. With only (paths relative to the root), checks just those files and the rules about
// instruction files, which is what the hook needs after an edit.
function doctor(dir, { only } = {}) {
  const out = []
  const fail = (area, msg) => out.push(`FAIL ${area}: ${msg}`)
  const warn = (area, msg) => out.push(`WARN ${area}: ${msg}`)
  const top = git(dir, ['rev-parse', '--show-toplevel'])
  if (top === null) return { lines: [`FAIL repository: ${dir} is not a git work tree`], failures: 1 }
  const root = top.trim()
  const at = p => path.join(root, p)
  const read = p => fs.readFileSync(at(p), 'utf8')
  const listed = only || (git(root, ['ls-files', '-co', '--exclude-standard']) || '').split('\n')
  const files = listed.filter(f => f && isFile(at(f)))

  let profile = {}
  if (fs.existsSync(at('.devflow.json'))) {
    try {
      profile = JSON.parse(read('.devflow.json'))
    } catch (e) {
      fail('profile', `.devflow.json does not parse (${e.message})`)
    }
  }
  if (profile.integration !== undefined && !INTEGRATIONS.includes(profile.integration)) {
    fail('profile', `integration is "${profile.integration}", not one of ${INTEGRATIONS.join(', ')}`)
  }
  const specsDir = profile.specs === undefined ? 'docs/specs' : profile.specs
  const decisionsDir = profile.decisions === undefined ? 'docs/design/decisions' : profile.decisions
  for (const [key, v] of [['specs', specsDir], ['decisions', decisionsDir]]) {
    if (v !== false && !insideFolder(v)) fail('profile', `${key} must be a folder inside the repository, or false`)
  }
  if (profile.agentsMd !== undefined && profile.agentsMd !== 'private') fail('profile', 'agentsMd is "private" or absent')
  const allowLocalPaths = profile.allowLocalPaths === undefined ? [] : profile.allowLocalPaths
  if (!Array.isArray(allowLocalPaths) || allowLocalPaths.some(g => typeof g !== 'string')) {
    fail('profile', 'allowLocalPaths is a list of path globs')
  }
  const localPathAllowed = f => Array.isArray(allowLocalPaths) && allowLocalPaths.some(g => typeof g === 'string' && matchesGlob(f, g))
  const privatePaths = profile.private || PRIVATE
  const isPrivate = f => privatePaths.some(p => f === p.replace(/\/$/, '') || f.startsWith(p))
  // What .gitattributes says about each file: binary content is not text, and eol=crlf (*.cmd, *.bat) is meant to be CRLF.
  const eol = (git(root, ['ls-files', '--eol', ...(only ? ['--', ...files] : [])]) || '').split('\n').filter(Boolean).map(l => l.split('\t'))
  const binary = new Set(eol.filter(([info]) => /attr\/-text/.test(info)).map(([, f]) => f))
  const crlf = new Set(eol.filter(([info]) => /attr\/.*eol=crlf/.test(info)).map(([, f]) => f))
  // Files git stores with LF: CRLF in the working tree is then a checkout setting (core.autocrlf), not the repository (#23).
  const storedLf = new Set(eol.filter(([info]) => /\bi\/lf\b/.test(info)).map(([, f]) => f))

  if (!only) {
    // Folders
    const required = [...REQUIRED, ...(profile.agentsMd === 'private' ? [] : ['AGENTS.md']),
      ...[specsDir, decisionsDir].filter(insideFolder)]
    for (const p of required) if (!fs.existsSync(at(p))) fail('folders', `missing ${p}`)
    if (profile.agentsMd === 'private' && (git(root, ['ls-files', '--', 'AGENTS.md']) || '').trim()) {
      fail('agents-md', 'agentsMd is private, but AGENTS.md is tracked; untrack it and ignore it')
    }

    // .gitignore managed block and private paths
    const ignore = fs.existsSync(at('.gitignore')) ? read('.gitignore').split(/\r?\n/) : []
    const a = ignore.indexOf('# >>> devflow (managed)')
    const b = ignore.indexOf('# <<< devflow')
    if (a < 0 || b < a) fail('gitignore', 'no "# >>> devflow (managed)" … "# <<< devflow" block')
    else {
      const block = ignore.slice(a + 1, b).map(l => l.trim()).filter(Boolean)
      const missing = MANAGED_IGNORE.filter(l => !block.includes(l))
      const extra = block.filter(l => !MANAGED_IGNORE.includes(l))
      if (missing.length) fail('gitignore', `managed block lacks ${missing.join(', ')}`)
      if (extra.length) warn('gitignore', `managed block has lines the standard does not: ${extra.join(', ')}`)
    }
    const leaked = (git(root, ['ls-files']) || '').split('\n').filter(f => f && isPrivate(f))
    if (leaked.length) fail('gitignore', `private paths are tracked: ${leaked.slice(0, 5).join(', ')}${leaked.length > 5 ? ` and ${leaked.length - 5} more` : ''}`)

    // .gitattributes
    const attributes = fs.existsSync(at('.gitattributes')) ? read('.gitattributes').split(/\r?\n/).map(l => l.trim()) : []
    const lacking = ATTRIBUTES.filter(l => !attributes.includes(l))
    if (lacking.length) fail('gitattributes', `lacks ${lacking.join(', ')}`)
    for (const [info, file] of eol) {
      if (/\bi\/(crlf|mixed)\b/.test(info) && /eol=lf|text=auto/.test(info)) fail('gitattributes', `${file} is stored with CRLF`)
      else if (/\bi\/-text\b/.test(info) && !/attr\/-text/.test(info)) warn('gitattributes', `${file} is binary but not marked binary`)
    }

    // Git hooks for repositories that integrate locally
    if (profile.integration === 'local-merge') {
      if ((git(root, ['config', 'core.hooksPath']) || '').trim() !== '.githooks') fail('git-hooks', 'core.hooksPath is not .githooks')
      if (!fs.existsSync(at('.githooks/pre-push'))) fail('git-hooks', 'no .githooks/pre-push')
    }
  }

  // AGENTS.md
  if ((!only || only.includes('AGENTS.md')) && isFile(at('AGENTS.md'))) {
    const text = read('AGENTS.md')
    for (const s of AGENTS_SECTIONS) if (!text.split(/\r?\n/).includes(s)) fail('agents-md', `no "${s}" section`)
    const emphasis = text.match(EMPHASIS) || []
    if (emphasis.length) warn('agents-md', `emphasis words (${[...new Set(emphasis)].join(', ')}): give the reason instead`)
    if (READ_LIST.test(text)) warn('agents-md', 'a fixed always-read list; tie each document to the situation that needs it')
    if (DATED.test(text)) warn('agents-md', 'a date or progress note; those belong in the Issue or the commit')
  }

  // Files that make Claude Code stop reading AGENTS.md, here or above, ignored by git or not
  const home = path.resolve(os.homedir())
  for (let d = path.resolve(root); ; d = path.dirname(d)) {
    for (const f of INSTRUCTION_SWITCHES) {
      const p = path.join(d, f)
      if (!(d === home && f === '.claude/CLAUDE.md') && fs.existsSync(p)) fail('instructions', `${p} makes Claude Code skip AGENTS.md`)
    }
    if (path.dirname(d) === d) break
  }

  // Document rules: line endings, hidden characters, local paths, budgets, links and anchors. They apply to text that can
  // be published: private paths are left to the .gitignore check, and binary content is not text.
  const anchorCache = new Map()
  const anchors = f => {
    if (!anchorCache.has(f)) anchorCache.set(f, new Set(read(f).split('\n').filter(l => /^#{1,6} /.test(l)).map(l => slug(l.replace(/^#+ /, '')))))
    return anchorCache.get(f)
  }
  for (const f of files) {
    if (f === 'LICENSE' || /\.(png|jpe?g|gif|ico|zip|gz)$/.test(f) || binary.has(f) || isPrivate(f)) continue
    const text = read(f)
    if (text.includes('\0')) continue
    if (text.includes('\r') && !crlf.has(f)) {
      if (storedLf.has(f)) warn('docs', `${f}: CRLF in the working tree only; git stores LF, so check the file out again to match`)
      else fail('docs', `${f}: CRLF line ending`)
    }
    if (text.charCodeAt(0) === 0xfeff) fail('docs', `${f}: byte order mark`)
    for (const [rule, re] of [['invisible character', INVISIBLE], ['local absolute path', localPathAllowed(f) ? USER_PATH : LOCAL_PATH]]) {
      const hits = text.split('\n').flatMap((line, i) => (re.test(line) ? [i + 1] : []))
      // A file that repeats a finding on many lines gets three of them and a count, so one file cannot bury the rest.
      for (const n of hits.slice(0, MAX_LINES_PER_RULE)) fail('docs', `${f}:${n}: ${rule}`)
      if (hits.length > MAX_LINES_PER_RULE) fail('docs', `${f}: ${rule} on ${hits.length - MAX_LINES_PER_RULE} more lines`)
    }
    for (const [re, max] of budgets(insideFolder(specsDir) ? specsDir : null)) if (re.test(f) && tokens(text) > max) fail('docs', `${f}: ~${tokens(text)} tokens, budget ${max}`)
    if (!f.endsWith('.md')) continue
    for (const m of text.replace(/```[\s\S]*?```/g, '').matchAll(/\]\(([^)\s]+)\)/g)) {
      if (/^[a-z]+:/i.test(m[1])) continue
      const [p, anchor] = m[1].split('#')
      const target = p ? path.posix.join(path.posix.dirname(f), p) : f
      if (!fs.existsSync(at(target))) {
        fail('docs', `${f}: missing link target ${m[1]}`)
        continue
      }
      if (!anchor || !isFile(at(target))) continue
      let wanted
      try {
        wanted = decodeURIComponent(anchor)
      } catch {
        fail('docs', `${f}: malformed anchor ${m[1]}`)
        continue
      }
      if (!anchors(target).has(wanted)) fail('docs', `${f}: missing anchor ${m[1]}`)
    }
  }

  // Private working documents: the names the resume card and the skills look for, and the prompt budget
  if (!only) {
    for (const dir of ['docs/prompts', 'docs/plans', 'artifacts/handoff']) {
      if (!fs.existsSync(at(dir))) continue
      for (const f of fs.readdirSync(at(dir))) {
        if (!f.endsWith('.md')) continue
        if (!PRIVATE_NAME.test(f)) warn('local-docs', `${dir}/${f}: name is not YYYY-MM-DD-i<issue>-<slug>-<prompt|plan|handoff>.md`)
        const size = dir === 'docs/prompts' && isFile(at(`${dir}/${f}`)) ? tokens(read(`${dir}/${f}`)) : 0
        if (size > PROMPT_BUDGET) warn('local-docs', `${dir}/${f}: ~${size} tokens, prompt budget ${PROMPT_BUDGET}`)
      }
    }
  }

  const failures = out.filter(l => l.startsWith('FAIL')).length
  const warnings = out.length - failures
  out.push(failures ? `${failures} failures${warnings ? `, ${warnings} warnings` : ''}` : warnings ? `ok (${warnings} warnings)` : 'ok')
  return { lines: out, failures }
}

if (require.main === module) {
  const r = doctor(process.argv[2] || process.cwd())
  process.stdout.write(r.lines.join('\n') + '\n')
  process.exitCode = r.failures ? 1 : 0
}

module.exports = { doctor }
