#!/usr/bin/env node
'use strict'
// Evaluation-only read grammar. It is copied into an isolated CODEX_HOME, never installed in a user's host.
const fs = require('node:fs')
const path = require('node:path')

function allowedFile(file, home, directory = false) {
  if (typeof file !== 'string' || /[\r\n`$*?\x00]/.test(file) || file.split(/[\\/]/).includes('..')) return false
  const resolved = path.resolve(file)
  if (resolved.toLowerCase() !== file.replaceAll('/', path.sep).toLowerCase()) return false
  const relative = path.relative(home, resolved).replaceAll('\\', '/')
  if (!/^(skills\/(?!\.system(?:\/|$))|docs\/)/.test(relative)) return false
  try {
    let at = home
    for (const part of relative.split('/')) {
      at = path.join(at, part)
      if (fs.lstatSync(at).isSymbolicLink()) return false
    }
    const stat = fs.statSync(resolved)
    return directory ? stat.isDirectory() : stat.isFile()
  } catch { return false }
}

const SHELL_TOOLS = ['Bash', 'PowerShell', 'exec_command', 'functions.exec_command']

function permits(input, home) {
  if (input?.hook_event_name !== 'PreToolUse') return false
  if (!SHELL_TOOLS.includes(input.tool_name)) return false
  const tool = input.tool_input
  if (!tool || typeof tool !== 'object' || Array.isArray(tool)) return false
  const keys = new Set(['command', 'cmd', 'workdir', 'cwd', 'login', 'description', 'timeout', 'yield_time_ms', 'max_output_tokens'])
  if (Object.keys(tool).some(k => !keys.has(k)) || (tool.command && tool.cmd && tool.command !== tool.cmd)) return false
  if (tool.login === true || tool.env || tool.shell || tool.sandbox_permissions) return false
  const command = tool.command ?? tool.cmd
  if (typeof command !== 'string' || command.length > 2048 || /[\r\n;|&<>`$\x00]/.test(command)) return false
  // Quotes are literal only: no shell operators, expansion, additional paths or arguments.
  const read = /^(?:Get-Content|cat)\s+(?:(?:-LiteralPath|-Path)\s+)?(['"])([^'"]+)\1(?:\s+-Raw)?\s*$/i.exec(command)
  if (read) return allowedFile(read[2], home)
  const list = /^Get-ChildItem\s+-LiteralPath\s+(['"])([^'"]+)\1(?:\s+-Recurse)?(?:\s+-File)?\s*$/i.exec(command)
  if (list) return allowedFile(list[2], home, true)
  const search = /^rg\s+(?:-n\s+)?--\s+(['"])([^'"]{1,128})\1\s+(['"])([^'"]+)\3\s*$/.exec(command)
  if (search) return allowedFile(search[4], home) || allowedFile(search[4], home, true)
  return false
}

function decision(input, home) {
  const allowed = permits(input, home)
  return { hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: allowed ? 'allow' : 'deny',
    permissionDecisionReason: allowed ? 'Public evaluation snapshot read.' : 'Evaluation permits only a single literal Get-Content/cat read, Get-ChildItem listing, or rg search inside the public snapshot. Other operations are blocked.',
    ...(allowed ? { updatedInput: { ...input.tool_input, login: false } } : {}) } }
}

function main() {
  const home = process.argv[2] || process.env.CODEX_HOME
  let publicRoot = ''
  try { publicRoot = JSON.parse(fs.readFileSync(path.join(home, 'eval-public-root.json'), 'utf8')).root } catch {}
  let text = '', finished = false
  const finish = input => {
    if (finished) return
    finished = true
    clearTimeout(timer)
    const output = decision(input, publicRoot)
    // Store bounded decisions, never command text, paths, tool output or credentials.
    if (home) {
      try { fs.appendFileSync(path.join(home, 'eval-guard-audit.jsonl'), JSON.stringify({ allowed: output.hookSpecificOutput.permissionDecision === 'allow', shell: SHELL_TOOLS.includes(input?.tool_name) }) + '\n') }
      catch { output.hookSpecificOutput.permissionDecision = 'deny' }
    }
    fs.writeSync(1, JSON.stringify(output))
    process.exit(0)
  }
  const timer = setTimeout(() => finish(null), 1000)
  process.stdin.setEncoding('utf8')
  process.stdin.on('data', chunk => { text += chunk; if (text.length > 65536) finish(null) })
  process.stdin.on('error', () => finish(null))
  process.stdin.on('end', () => { let input; try { input = JSON.parse(text) } catch {}; finish(input) })
}

module.exports = { allowedFile, permits, decision }
if (require.main === module) main()
