{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/devflow-hook.js').main()\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|Write|NotebookEdit|apply_patch|mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb].*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/devflow-hook.js').main()\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|NotebookEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/devflow-hook.js').main()\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/devflow-hook.js').main()\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/devflow-hook.js').main()\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
